@using HandymanWorkshop.Client.Pages.Components
@page "/Department/Create"
@inject HttpClient Http
@using System.Text.Json.Serialization

<PageTitle>Create Department</PageTitle>

<AuthorizeView Roles="Admin,SuperUser">
    <Authorized Context="authContext">

        <div class="container mb-5">
            <h3>Create</h3>

            <EditForm Model="@department" OnValidSubmit="@AddDepartment">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="w-35">

                      <FormTextField 
                                    Id="name"
                                   Label="Name"
                                   @bind-Value="department.Name"
                                   Required="true" />

                    <FormTextField Id="email"
                                   Label="Email"
                                   @bind-Value="department.Email"
                                   Required="true" />

                    <FormTextField Id="address"
                                   Label="Address"
                                   @bind-Value="department.Address"
                                   Required="true" />

                    <FormTextField Id="postcode"
                                   Label="Postcode"
                                   @bind-Value="department.Postcode"
                                   Required="true" />

                </div>
              

                <button type="submit" class="btn btn-primary">Create</button>
            </EditForm>
            <br />
            <br />
            <button type="button" class="btn btn-secondary" @onclick='() => NavMan.NavigateTo("/Department")'>Cancel</button>
            <br />
        </div>


    </Authorized>
</AuthorizeView>


