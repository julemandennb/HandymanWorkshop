@using Shared.DTO.Employee
@using Microsoft.AspNetCore.Components.Authorization

@if (showFliter)
{
    <div class="card shadow-sm mb-4 p-2">
        <div class="row g-3 mb-3">
            <div class="col-md-4">
                <label for="employeeSearch" class="form-label">Search</label>
                <input id="employeeSearch"
                type="search"
                class="form-control"
                placeholder="Search by name, email or ID..."
                @bind="searchTerm"
                @bind:event="oninput" />
            </div>

            <div class="col-md-3">
                <label for="employeeSortBy" class="form-label">Sort by</label>
                <InputSelect id="employeeSortBy"
                class="form-select"
                @bind-Value="sortBy">
                    <option value="Name">Name</option>
                    <option value="Email">Email</option>
                    <option value="Uuid">ID</option>
                </InputSelect>
            </div>

            <div class="col-md-3">
                <label for="employeeSortDirection" class="form-label">
                    Sort direction
                </label>
                <InputSelect id="employeeSortDirection"
                class="form-select"
                @bind-Value="sortDescending">
                    <option value="false">Ascending</option>
                    <option value="true">Descending</option>
                </InputSelect>
            </div>

            <div class="col-md-2 d-flex align-items-end">
                <button type="button"
                class="btn btn-secondary"
                @onclick="ClearFilters">
                    Clear
                </button>
            </div>
        </div>

        <p>
            Showing @FilteredEmployees.Count of
            @(Employees?.Count() ?? 0) employees
        </p>

    </div>
}
<div class="table-responsive">
    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Email</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in FilteredEmployees)
            {
                <tr>
                    <td>@item.Uuid</td>
                    <td>@item.Name</td>
                    <td>@item.Email</td>
                    <td>
                        <a href="/Employee/Details/@item.Uuid"
                           class="btn btn-info btn-sm me-1">
                            Details
                        </a>

                        <AuthorizeView Roles="Admin,SuperUser">
                            <Authorized Context="authContext">
                                <a href="/Employee/Edit/@item.Uuid"
                                   class="btn btn-info btn-sm me-1">
                                    Edit
                                </a>

                                <a href="/Employee/Delete/@item.Uuid"
                                   class="btn btn-danger btn-sm">
                                    Delete
                                </a>
                            </Authorized>
                        </AuthorizeView>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter]
    public IEnumerable<EmployeeDto>? Employees { get; set; }

    [Parameter]
    public bool showFliter { get; set; } = false;

    private string searchTerm = string.Empty;
    private string sortBy = "Name";
    private bool sortDescending;

    private List<EmployeeDto> FilteredEmployees
    {
        get
        {
            IEnumerable<EmployeeDto> query =
                Employees ?? Enumerable.Empty<EmployeeDto>();

            // Search by name, email or ID
            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                var search = searchTerm.Trim();

                query = query.Where(e =>
                    (e.Name?.Contains(
                        search, StringComparison.OrdinalIgnoreCase) ?? false)
                    ||
                    (e.Email?.Contains(
                        search, StringComparison.OrdinalIgnoreCase) ?? false)
                    ||
                    e.Uuid.ToString().Contains(
                        search, StringComparison.OrdinalIgnoreCase));
            }

            // Sort employees
            switch (sortBy)
            {
                case "Uuid":
                    query = sortDescending
                        ? query.OrderByDescending(e => e.Uuid)
                        : query.OrderBy(e => e.Uuid);
                    break;

                case "Email":
                    query = sortDescending
                        ? query.OrderByDescending(e => e.Email)
                        : query.OrderBy(e => e.Email);
                    break;

                case "Name":
                default:
                    query = sortDescending
                        ? query.OrderByDescending(e => e.Name)
                        : query.OrderBy(e => e.Name);
                    break;
            }

            return query.ToList();
        }
    }

    private void ClearFilters()
    {
        searchTerm = string.Empty;
        sortBy = "Name";
        sortDescending = false;
    }
}
