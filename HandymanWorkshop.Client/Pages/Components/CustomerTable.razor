@using Shared.DTO.Customer

<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Email</th>
            <th>PhoneNumber</th>
            <th>Address</th>
            <th>Postcode</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @if (customers != null)
        {
            @foreach (var item in customers)
            {
                <tr>
                    <td>@item.Uuid</td>
                    <td>@item.Name</td>
                    <td>@item.Email</td>
                    <td>@item.PhoneNumber</td>
                    <td>@item.Address</td>
                    <td>@item.Postcode</td>
                    <td>
                        <a href="/Customer/Details/@item.Uuid"
                           class="btn btn-info btn-sm">
                            Details
                        </a>

                        <AuthorizeView Roles="Admin,SuperUser">
                            <Authorized Context="authContext">
                                <a href="/Customer/Edit/@item.Uuid"
                                   class="btn btn-info btn-sm">
                                    Edit
                                </a>

                                <a href="/Customer/Delete/@item.Uuid"
                                   class="btn btn-danger btn-sm">
                                    Delete
                                </a>
                            </Authorized>
                        </AuthorizeView>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

@code {
    [Parameter]
    public IEnumerable<CustomerDto>? customers { get; set; }
}
