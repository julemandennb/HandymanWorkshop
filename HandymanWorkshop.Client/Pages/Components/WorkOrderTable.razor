@using Shared.DTO.WorkOrder

<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Title</th>
            <th>Status</th>
            <th>ScheduledDate</th>
            <th>EstimatedHours</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @if (WorkOrders != null)
        {
            @foreach (var item in WorkOrders)
            {
                <tr>
                    <td>@item.Uuid</td>
                    <td>@item.Title</td>
                    <td>@item.Status</td>
                    <td>@item.ScheduledDate</td>
                    <td>@item.EstimatedHours</td>
                    <td>
                        <a href="/WorkOrder/Details/@item.Uuid"
                           class="btn btn-info btn-sm">
                            Details
                        </a>

                        <AuthorizeView Roles="Admin,SuperUser">
                            <Authorized Context="authContext">
                                <a href="/WorkOrder/Edit/@item.Uuid"
                                   class="btn btn-info btn-sm">
                                    Edit
                                </a>

                                <a href="/WorkOrder/Delete/@item.Uuid"
                                   class="btn btn-danger btn-sm">
                                    Delete
                                </a>
                            </Authorized>
                        </AuthorizeView>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

@code {
    [Parameter]
    public IEnumerable<WorkOrderDto>? WorkOrders { get; set; }
}
