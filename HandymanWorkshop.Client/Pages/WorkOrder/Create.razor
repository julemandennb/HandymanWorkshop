@using HandymanWorkshop.Client.Pages.Components
@page "/WorkOrder/Create"
@inject HttpClient Http

<PageTitle>Create WorkOrder</PageTitle>

<AuthorizeView Roles="Admin,SuperUser,User,Customer">
    <Authorized Context="authContext">

        <div class="container mb-5">
            <h3>Create</h3>

            <EditForm Model="@workOrder" OnValidSubmit="@AddWorkOrder">
                <DataAnnotationsValidator />
                <ValidationSummary />

                

                <div class="w-35">

                    <FormTextField Id="title"
                                   Label="Title"
                                   @bind-Value="workOrder.Title"
                                   Required="true" />

                    <FormTextField Id="description"
                                   Label="Description"
                                   @bind-Value="workOrder.Description"
                                   Required="true" />

                    <div class="mb-3 d-flex flex-row justify-content-between align-items-start">
                        <label class="form-label " for="scheduledDate">Scheduled Date</label>

                        <div>
                                <InputDate
                                        class="form-input"
                                       id="scheduledDate"
                                       name="scheduledDate"
                                       @bind-Value="workOrder.ScheduledDate"
                                       />
                        </div>
                    </div>
                                   
                        <FormSelectField Id="customer"
                                         Label="Customer"
                                         @bind-Value="workOrder.Customer.Uuid"
                                         Required="true"
                                         Options="@CustomerOptions" />
                  

                     <FormSelectField Id="department"
                                     Label="Department"
                                     @bind-Value="workOrder.Department.Uuid"
                                     Required="true"
                                     Options="@DepartmentOptions"
                                     @bind-Value:after="GetItmeFrmoDepartment" 
                                     />

                    <FormSelectField Id="employee"
                                     Label="Employee"
                                     @bind-Value="workOrder.Employee.Uuid"
                                     Required="true"
                                     Options="@EmployeeOptions" />

                </div>
              

                <button type="submit" class="btn btn-primary">Create</button>
            </EditForm>
            <br />
            <br />
            <button type="button" class="btn btn-secondary" @onclick='() => NavMan.NavigateTo("/WorkOrder")'>Cancel</button>
            <br />
        </div>


    </Authorized>
</AuthorizeView>


