@page "/WorkOrder/Create"
@using HandymanWorkshop.Client.Pages.Components
@using Shared.DTO.Pivot
@inject HttpClient Http

<PageTitle>Create WorkOrder</PageTitle>

<AuthorizeView Roles="Admin,SuperUser,User,Customer">
    <Authorized Context="authContext">

        <div class="container mb-5">
            <h3>Create Work Order</h3>

            <EditForm Model="@workOrder" OnValidSubmit="@AddWorkOrder">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="w-35">

                    <FormTextField Id="title"
                                   Label="Title"
                                   @bind-Value="workOrder.Title"
                                   Required="true" />

                    <FormTextArea Id="description"
                                  Label="Description"
                                  @bind-Value="workOrder.Description"
                                  Required="true" />

                    <FormDate Id="scheduledDate"
                              Label="Scheduled Date"
                              @bind-Value="workOrder.ScheduledDate"
                                  Required="true" />

                    <FormSelectField Id="customer"
                                     Label="Customer"
                                     @bind-Value="workOrder.Customer.Uuid"
                                     Required="true"
                                     Options="@CustomerOptions" />

                    <FormSelectField Id="department"
                                     Label="Department"
                                     @bind-Value="workOrder.Department.Uuid"
                                     Required="true"
                                     Options="@DepartmentOptions"
                                     @bind-Value:after="GetItemFromDepartment" />

                    <FormSelectField Id="employee"
                                     Label="Employee"
                                     @bind-Value="workOrder.Employee.Uuid"
                                     Required="true"
                                     Options="@EmployeeOptions" />

                </div>

                <hr />

                <h4>Products</h4>

                @if (isLoadingProducts)
                {
                    <p>Loading department products...</p>
                }
                else if (ProductOptions == null || !ProductOptions.Any())
                {
                    <p>No products are available for the selected department.</p>
                }
                else
                {
                    <div class="row mb-3">
      
                        <div class="col-md-8">

                                <FormSelectField Id="productSelect"
                                         Label="Select Product"
                                             DivClass="d-flex flex-row justify-content-between align-items-start"
                                         @bind-Value="SelectedProductUuid"
                                         Required="false"
                                         Options="@AvailableProductOptions" />
                        </div>

                        <div class="col-md-4 d-flex align-items-end">
                            <button type="button"
                                    class="btn btn-secondary"
                                    @onclick="AddProduct"
                                    disabled="@(SelectedProductUuid == Guid.Empty)">
                                Add Product
                            </button>
                        </div>
                    </div>

                    @if (SelectedProducts.Any())
                    {
                        <h5>Selected Products</h5>

                        <div class="table-responsive">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Product</th>
                                        <th style="width: 150px;">Quantity</th>
                                        <th style="width: 120px;">Action</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var product in SelectedProducts)
                                    {
                                        <tr @key="product.ProductUuid">
                                            <td>@product.ProductName</td>

                                            <td>
                                                <InputNumber class="form-control"
                                                             min="1"
                                                             @bind-Value="product.Quantity" />

                                                @if (product.Quantity < 1)
                                                {
                                                    <small class="text-danger">
                                                        Quantity must be at least 1.
                                                    </small>
                                                }
                                            </td>

                                            <td>
                                                <button type="button"
                                                        class="btn btn-danger btn-sm"
                                                        @onclick="() => RemoveProduct(product.ProductUuid)">
                                                    Remove
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p>No products selected yet.</p>
                    }
                }

                @if (!string.IsNullOrWhiteSpace(ErrorMessage))
                {
                    <div class="alert alert-danger mt-3">
                        @ErrorMessage
                    </div>
                }

                <button type="submit"
                        class="btn btn-primary mt-3"
                        disabled="@isSaving">
                    @(isSaving ? "Creating..." : "Create")
                </button>
            </EditForm>

            <br />

            <button type="button"
                    class="btn btn-secondary"
                    @onclick='() => NavMan.NavigateTo("/WorkOrder")'
                    disabled="@isSaving">
                Cancel
            </button>
        </div>

    </Authorized>
</AuthorizeView>

