@page "/WorkOrder/Details/{id}"
@inject HttpClient Http
@using HandymanWorkshop.Client.Pages.Components

<PageTitle>Work Order Details</PageTitle>

<div class="container mb-5">
    <h3>Work Order Details</h3>

    <button type="button"
            class="btn btn-secondary mb-4"
            @onclick='() => NavMan!.NavigateTo("/WorkOrder")'>
        All Work Orders
    </button>

    @if (isLoading)
    {
        <p>Loading work order...</p>
    }
    else if (workOrder == null)
    {
        <div class="alert alert-warning">
            Cannot find work order.
        </div>
    }
    else
    {
        <div class="mb-4">
            <p><strong>Id:</strong> @workOrder.Uuid</p>
            <p><strong>Title:</strong> @workOrder.Title</p>
            <p>
                <strong>Description:</strong><br />
                <span style="white-space: pre-line;">@workOrder.Description</span>
            </p>
            <p><strong>Status:</strong> @workOrder.Status</p>
            <p><strong>Scheduled Date:</strong> @workOrder.ScheduledDate?.ToString("dd/MM/yyyy")</p>
            <p><strong>Estimated Hours:</strong> @workOrder.EstimatedHours</p>
            <p><strong>Hourly Rate:</strong> @workOrder.HourlyRate.ToString("C", dkCulture)</p>
            <p><strong>Labor Price:</strong> @price.ToString("C", dkCulture)</p>

            <p><strong>Employee:</strong> @workOrder.Employee?.Name</p>
            <p><strong>Department:</strong> @workOrder.Department?.Name</p>
            <p><strong>Customer:</strong> @workOrder.Customer?.Name</p>
        </div>

        <hr />

        <h4>Products</h4>

        @if (workOrder.WorkOrderProducts == null ||
             !workOrder.WorkOrderProducts.Any())
        {
            <p>No products assigned to this work order.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Quantity</th>
                            <th>Unit Price</th>
                            <th>Subtotal</th>
                            <th>Added By</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in workOrder.WorkOrderProducts)
                        {
                            <tr>
                                <td>@item.ProductName</td>
                                <td>@item.Quantity</td>
                                <td>@item.UnitPrice.ToString("C", dkCulture)</td>
                                <td>@((item.Quantity * item.UnitPrice).ToString("C", dkCulture))</td>
                                <td>@item.AddedByUser</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th colspan="3" class="text-end">
                                Total Products
                            </th>
                            <th colspan="2">
                                @productTotal.ToString("C", dkCulture)
                            </th>
                        </tr>
                        <tr>
                            <th colspan="3" class="text-end">
                                Labor + Products
                            </th>
                            <th colspan="2">
                                @((price + productTotal).ToString("C", dkCulture))
                            </th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
    }
</div>
