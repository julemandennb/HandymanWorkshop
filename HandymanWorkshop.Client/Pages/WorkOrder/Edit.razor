
@page "/WorkOrder/Edit/{id}"
@using HandymanWorkshop.Client.Pages.Components
@using Shared.Enum
@using Shared.DTO

<PageTitle>Edit Work Order</PageTitle>

<AuthorizeView Roles="Admin,SuperUser,User">
    <Authorized Context="authContext">
        <div class="container mb-5">
            <h3>Edit Work Order</h3>

            <button type="button"
                    class="btn btn-secondary mb-4"
                    @onclick='() => NavMan.NavigateTo("/WorkOrder")'>
                All Work Orders
            </button>

            @if (isLoading)
            {
                <p>Loading work order...</p>
            }
            else if (workOrder == null)
            {
                <div class="alert alert-warning">
                    Work order not found.
                </div>
            }
            else
            {
                <EditForm Model="@workOrder" OnValidSubmit="@SaveChanges">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                <div class="w-35">

                        <FormTextField Id="title"
                            Label="Title"
                            @bind-Value="workOrder.Title"
                            Required="true" />
                  

                        <FormTextField Id="description"
                                       Label="Description"
                                       @bind-Value="workOrder.Description"
                                       Required="true" />

                        <div class="mb-3">
                            <label class="form-label">Customer</label>
                            <input class="form-control"
                                   value="@workOrder.Customer?.Name"
                                   readonly />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Department</label>
                            <input class="form-control"
                                   value="@workOrder.Department?.Name"
                                   readonly />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Employee</label>
                            <input class="form-control"
                                   value="@workOrder.Employee?.Name"
                                   readonly />
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="estimatedHours">
                                Estimated Hours
                            </label>

                            <InputNumber id="estimatedHours"
                                         class="form-control"
                                         @bind-Value="workOrder.EstimatedHours"
                                         min="0"
                                         step="0.5" />

                            <ValidationMessage For="@(() => workOrder.EstimatedHours)" />
                        </div>
                    
                        <div class="mb-4">
                            <label class="form-label" for="status">
                                Work Order Status
                            </label>

                            <InputSelect id="status"
                                         class="form-select"
                                         @bind-Value="workOrder.Status">
                                @foreach (var status in Enum.GetValues<WorkOrderStatus>())
                                {
                                    <option value="@status">@status</option>
                                }
                            </InputSelect>
                        </div>

                    </div>

                    <hr />

                    <h4>Work Order Products</h4>

                    @if (isLoadingProducts)
                    {
                        <p>Loading department products...</p>
                    }
                    else
                    {
                        <div class="row mb-3">
                            <div class="col-md-8">
                                <label class="form-label" for="productSelect">
                                    Add Product
                                </label>

                                <select id="productSelect"
                                        class="form-select"
                                        @bind="SelectedProductUuid">
                                    <option value="">-- Select product --</option>

                                    @foreach (var product in AvailableProductOptions)
                                    {
                                        <option value="@product.Value">
                                            @product.Text
                                        </option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-4 d-flex align-items-end">
                                <button type="button"
                                        class="btn btn-secondary"
                                        @onclick="AddProduct"
                                        disabled="@string.IsNullOrWhiteSpace(SelectedProductUuid)">
                                    Add Product
                                </button>
                            </div>
                        </div>

                        @if (SelectedProducts.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-striped table-bordered">
                                    <thead>
                                        <tr>
                                            <th>Product</th>
                                            <th style="width: 130px;">Quantity</th>
                                            <th style="width: 150px;">Unit Price</th>
                                            <th>Subtotal</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>

                                    <tbody>
                                        @foreach (var product in SelectedProducts)
                                        {
                                            <tr @key="product.ProductUuid">
                                                <td>@product.ProductName</td>

                                                <td>
                                                    <InputNumber class="form-control"
                                                                 min="1"
                                                                 @bind-Value="product.Quantity" />
                                                </td>

                                                <td>
                                                    @product.UnitPrice.ToString("C")
                                                </td>

                                                <td>
                                                    @((product.Quantity * product.UnitPrice).ToString("C"))
                                                </td>

                                                <td>
                                                    <button type="button"
                                                            class="btn btn-danger btn-sm"
                                                            @onclick="() => RemoveProduct(product.ProductUuid)">
                                                        Remove
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>

                                    <tfoot>
                                        <tr>
                                            <th colspan="3" class="text-end">
                                                Product Total
                                            </th>
                                            <th colspan="2">
                                                @ProductTotal.ToString("C")
                                            </th>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        }
                        else
                        {
                            <p>No products assigned to this work order.</p>
                        }
                    }

                    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
                    {
                        <div class="alert alert-danger mt-3">
                            @ErrorMessage
                        </div>
                    }

                    <button type="submit"
                            class="btn btn-primary mt-3"
                            disabled="@isSaving">
                        @(isSaving ? "Saving..." : "Save Changes")
                    </button>

                    <button type="button"
                            class="btn btn-secondary mt-3 ms-2"
                            @onclick='() => NavMan.NavigateTo($"/WorkOrder/Details/{id}")'
                            disabled="@isSaving">
                        Cancel
                    </button>
                </EditForm>
            }
        </div>
    </Authorized>

    <NotAuthorized>
        <div class="alert alert-danger">
            You are not authorized to edit work orders.
        </div>
    </NotAuthorized>
</AuthorizeView>