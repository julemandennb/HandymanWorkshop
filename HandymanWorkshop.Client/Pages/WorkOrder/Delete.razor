@page "/WorkOrder/Delete/{id}"
@using Shared.DTO.WorkOrder
@using HandymanWorkshop.Client.Pages.Components

<PageTitle>Delete Work Order</PageTitle>

<div class="container mb-5">
    <h3>Delete Work Order</h3>

    <button type="button"
            class="btn btn-secondary mb-5"
            @onclick='() => NavMan.NavigateTo("/WorkOrder")'>
        All Work Orders
    </button>

    @if (workOrder == null)
    {
        <p>Cannot find work order.</p>
    }
    else
    {
        <div class="mb-3">
            <p><strong>Id:</strong> @workOrder.Uuid</p>
            <p><strong>Title:</strong> @workOrder.Title</p>
            <p><strong>Description:</strong> @workOrder.Description</p>
            <p><strong>Scheduled Date:</strong> @workOrder.ScheduledDate</p>
            <p><strong>Estimated Hours:</strong> @workOrder.EstimatedHours</p>
            <p><strong>Hourly Rate:</strong> @workOrder.HourlyRate</p>
            <p><strong>Status:</strong> @workOrder.Status</p>
        </div>

        <AuthorizeView Roles="Admin,SuperUser">
            <Authorized>
                @if (workOrder.WorkOrderProducts == null ||
                     workOrder.WorkOrderProducts.Count == 0)
                {
                    <p>No products assigned to this work order.</p>
                }
                else
                {
                    <h5>Products</h5>

                    <table class="table">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Quantity</th>
                                <th>Unit Price</th>
                                <th>Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in workOrder.WorkOrderProducts)
                            {
                                <tr>
                                    <td>@item.ProductName</td>
                                    <td>@item.Quantity</td>
                                    <td>@item.UnitPrice.ToString("C")</td>
                                    <td>@((item.Quantity * item.UnitPrice).ToString("C"))</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }

                <div class="alert alert-warning">
                    Are you sure you want to delete this work order?
                </div>

                <button type="button"
                        class="btn btn-danger"
                        disabled="@isDeleting"
                        @onclick="DeleteWorkOrder">
                    @(isDeleting ? "Deleting..." : "Delete Work Order")
                </button>

                <button type="button"
                        class="btn btn-secondary ms-2"
                        disabled="@isDeleting"
                        @onclick='() => NavMan.NavigateTo("/WorkOrder")'>
                    Cancel
                </button>

                @if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <p class="text-danger mt-3">@errorMessage</p>
                }
            </Authorized>
        </AuthorizeView>
    }
</div>