@page "/Profiles"
@using Shared.DTO.ApplicationUser
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Web
@attribute [Authorize(Roles = "Admin")]

@inject HttpClient Http
@inject NavigationManager NavMan
@inject IJSRuntime JS

<PageTitle>Profiles</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>Profiles</h3>

        <button class="btn btn-primary mb-5"
                @onclick='() => NavMan.NavigateTo("/Profiles/Create")'>
            Create Profile
        </button>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">
            @errorMessage
        </div>
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success">
            @successMessage
        </div>
    }

    @if (isLoading)
    {
        <p>Loading profiles...</p>
    }
    else
    {
        <div class="card shadow-sm mb-4 p-2">
            <div class="row g-3 mb-3">
            <div class="col-md-5">
                <label for="profileSearch" class="form-label">
                    Search profiles
                </label>
                <input id="profileSearch"
                       type="search"
                       class="form-control"
                       placeholder="Search name, email, role or ID..."
                       @bind="searchTerm"
                       @bind:event="oninput" />
            </div>

            <div class="col-md-3">
                <label for="profileSortBy" class="form-label">
                    Sort by
                </label>
                <InputSelect id="profileSortBy"
                        class="form-select"
                        @bind-Value="sortBy">
                    <option value="Name">Name</option>
                    <option value="Email">Email</option>
                    <option value="Role">Role</option>
                    <option value="Id">ID</option>
                </InputSelect>
            </div>

            <div class="col-md-2">
                <label for="profileSortDirection" class="form-label">
                    Direction
                </label>
                <InputSelect id="profileSortDirection"
                        class="form-select"
                             @bind-Value="sortDescending">
                    <option value="false">Ascending</option>
                    <option value="true">Descending</option>
                </InputSelect>
            </div>

            <div class="col-md-2 d-flex align-items-end">
                <button type="button"
                        class="btn btn-secondary"
                        @onclick="ClearFilters">
                    Clear
                </button>
            </div>
        </div>

        <p>
            Showing @FilteredProfiles.Count of @profiles.Count profiles
        </p>

        </div>

        @if (FilteredProfiles.Count == 0)
        {
            <p>No matching profiles found.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-bordered align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Role</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var profile in FilteredProfiles)
                        {
                            <tr @key="profile.Id">
                                <td>@profile.Name</td>
                                <td>@profile.Email</td>
                                <td>@profile.Role</td>
                                <td>
                                    <div class="d-flex gap-2 flex-wrap">
                                        <button class="btn btn-warning btn-sm"
                                                disabled="@isWorking"
                                                @onclick="() => ResendPassword(profile)">
                                            Send new password
                                        </button>

                                        <button class="btn btn-danger btn-sm"
                                                disabled="@isWorking"
                                                @onclick="() => DeleteProfile(profile)">
                                            Delete
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</div>
